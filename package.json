{
  "name": "react-native-network-debug",
  "version": "1.0.0",
  "description": "An in-app HTTP traffic inspector for React Native — zero dependencies, redesigned UI, RN 0.81+",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "source": "src/index.tsx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tranhuuthinhit/react-native-network-debug.git"
  },
  "bugs": {
    "url": "https://github.com/tranhuuthinhit/react-native-network-debug/issues"
  },
  "homepage": "https://github.com/tranhuuthinhit/react-native-network-debug#readme",
  "keywords": [
    "react",
    "native",
    "react-native",
    "network",
    "interceptor",
    "http",
    "monitor",
    "logging",
    "debug",
    "devtools",
    "inspector",
    "ios",
    "android"
  ],
  "author": "tranhuuthinhit",
  "license": "MIT",
  "files": [
    "lib",
    "src",
    "!lib/typescript/example",
    "!**/__tests__",
    "!**/*.spec.ts",
    "!**/*.spec.tsx",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "test": "jest",
    "typescript": "tsc --noEmit",
    "lint": "npm run eslint && npm run prettier",
    "eslint": "eslint \"src/**/*.{ts,tsx}\"",
    "prettier": "prettier --check \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "build": "bob build",
    "prepare": "bob build",
    "verify": "npm run typescript && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native/babel-preset": "0.81.0",
    "@testing-library/react-native": "~13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.8",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "react": "19.1.0",
    "react-native": "0.81.0",
    "react-native-builder-bob": "^0.40.18",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.81.0"
  },
  "peerDependenciesMeta": {
    "@react-native-clipboard/clipboard": {
      "optional": true
    },
    "expo-clipboard": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "jest": {
    "preset": "react-native",
    "setupFiles": [
      "<rootDir>/jest-setup.js"
    ],
    "testMatch": [
      "**/src/**/*.spec.ts",
      "**/src/**/*.spec.tsx"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
